---
import type { MarkdownHeading } from 'astro';
import type { Post } from '../lib/posts';
import { estimateReadingMinutes, formatDateLong, toISO } from '../lib/format';
import { postCover } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagPill from '../components/TagPill.astro';
import CodeCopyButton from '../components/CodeCopyButton.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import BackToTop from '../components/BackToTop.astro';

export interface Props {
  post: Post;
  headings: MarkdownHeading[];
  /** 正文原文，用于估算阅读时长。由页面层从 collection entry 取后传入。 */
  body?: string;
  prevPost?: Post;
  nextPost?: Post;
  /** 相关推荐，由页面层算好传入 */
  related?: Post[];
}

const { post, headings, body = '', prevPost, nextPost, related = [] } =
  Astro.props satisfies Props;
const { title, description, date, tags, pinned } = post.data;

const readingMinutes = estimateReadingMinutes(body);
// 只有 h2/h3 进目录。与 TableOfContents 的过滤规则保持一致。
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocItems.length > 0;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={date}
  modifiedTime={date}
  ogImage={postCover(post)}
  tags={tags}
  jsonLdType="BlogPosting"
>
  <div class="container post-page">
    <a href="/" class="post-page__back">← 返回文章列表</a>

    <header class="post-header">
      <h1 class="post-header__title">{title}</h1>
      <div class="post-header__meta">
        <time datetime={toISO(date)}>{formatDateLong(date)}</time>
        <span aria-hidden="true">·</span>
        <span>约 {readingMinutes} 分钟阅读</span>
        {pinned && <span class="post-header__badge">置顶</span>}
      </div>
      {
        tags.length > 0 && (
          <div class="post-header__tags">
            {tags.map((tag) => (
              <TagPill tag={tag} />
            ))}
          </div>
        )
      }
    </header>

    <!--
      grid 布局：正文与 TOC 是兄弟节点，TOC 不会被注入正文内部。
      这样中文长文的行高和阅读节奏不受任何影响。
      无目录时不渲染侧栏，正文占满宽度。
    -->
    <div class:list={['post-grid', { 'post-grid--no-toc': !hasToc }]}>
      <div class="post-grid__main">
        <div class="prose">
          <slot />
        </div>
        <CodeCopyButton />

        {
          (prevPost || nextPost) && (
            <nav class="post-nav" aria-label="文章导航">
              {prevPost ? (
                <a href={`/blog/${prevPost.id}/`} class="post-nav__item post-nav__item--prev">
                  <span class="post-nav__label">← 上一篇</span>
                  <span class="post-nav__title">{prevPost.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {nextPost && (
                <a href={`/blog/${nextPost.id}/`} class="post-nav__item post-nav__item--next">
                  <span class="post-nav__label">下一篇 →</span>
                  <span class="post-nav__title">{nextPost.data.title}</span>
                </a>
              )}
            </nav>
          )
        }

        <RelatedPosts currentTags={tags} posts={related} />
      </div>

      <aside class="post-grid__side">
        <div class="post-grid__sticky">
          <TableOfContents headings={tocItems} />
        </div>
      </aside>
    </div>
  </div>

  <BackToTop />
</BaseLayout>

<style>
  .post-page {
    max-width: 68rem;
  }

  .post-page__back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .post-page__back:hover {
    color: var(--accent);
  }

  .post-header {
    margin-bottom: var(--space-6);
  }

  .post-header__title {
    font-size: 2rem;
    line-height: 1.3;
    margin: 0 0 0.75rem;
  }

  .post-header__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .post-header__badge {
    padding: 0.1em 0.55em;
    font-size: 0.75rem;
    border-radius: 999px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .post-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-4);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }

    /* 没有目录时正文占满宽度，不留空列 */
    .post-grid--no-toc {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-grid--no-toc .post-grid__side {
      display: none;
    }
  }

  .post-grid__sticky {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .post-nav__item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition), transform var(--transition);
  }

  .post-nav__item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .post-nav__item--next {
    text-align: right;
  }

  .post-nav__label {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .post-nav__title {
    font-size: 0.9375rem;
    color: var(--text-strong);
    line-height: 1.5;
  }

  @media (max-width: 40rem) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav__item--next {
      text-align: left;
    }
  }
</style>
