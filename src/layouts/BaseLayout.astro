---
/**
 * 基础布局：文档骨架、SEO、字体、固定环境层、导航与页脚。
 *
 * 站点只有深色一套视觉，不再有主题切换与首帧防闪烁脚本。
 */
import '@/styles/global.css';
import '@/styles/prose.css';
import '@/styles/shiki.css';

import SiteNav from '@/components/ui/SiteNav.astro';
import SiteFooter from '@/components/ui/SiteFooter.astro';
import HomeAmbience from '@/components/ui/HomeAmbience.astro';
import {
  absoluteUrl,
  DEFAULT_OG_IMAGE,
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_ORIGIN,
} from '@/lib/site';

export interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 分享图路径（站内绝对路径）。不传则用站点默认图 */
  ogImage?: string;
  tags?: string[];
  jsonLdType?: 'Blog' | 'BlogPosting';
  /** 404 等不需要收录的页面 */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  ogImage = DEFAULT_OG_IMAGE,
  tags = [],
  jsonLdType = 'Blog',
  noindex = false,
} = Astro.props satisfies Props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_ORIGIN);
const ogImageUrl = absoluteUrl(ogImage);
const base = import.meta.env.BASE_URL;

// ---------- JSON-LD ----------
const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE_ORIGIN}/#website`,
  url: `${SITE_ORIGIN}/`,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  inLanguage: 'zh-CN',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteNode,
    {
      '@type': jsonLdType,
      '@id': `${canonical.href}#${jsonLdType.toLowerCase()}`,
      url: canonical.href,
      headline: title,
      name: pageTitle,
      description,
      inLanguage: 'zh-CN',
      isPartOf: { '@id': websiteNode['@id'] },
      ...(jsonLdType === 'BlogPosting'
        ? {
            datePublished: publishedTime?.toISOString(),
            dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
            author: { '@type': 'Person', name: SITE_AUTHOR },
            keywords: tags.length > 0 ? tags.join(', ') : undefined,
            image: ogImageUrl,
          }
        : {}),
    },
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />

    <meta name="theme-color" content="#05050c" />
    <meta name="color-scheme" content="dark" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />

    <!-- 与梦澄中心共用同一个透明品牌标记作为浏览器图标 -->
    <link rel="icon" href={`${base}brand/logo.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}brand/logo.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <!-- 预加载拉丁字体分片，让首屏字标更早完成绘制 -->
    <link
      rel="preload"
      href={`${base}fonts/misans-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href={`${base}fonts/fonts.css`} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="ys-skip-link" href="#main-content">
      跳转到主要内容
    </a>

    <HomeAmbience />
    <SiteNav />

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
