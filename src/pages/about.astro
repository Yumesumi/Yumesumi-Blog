---
import { getEntry, render } from 'astro:content';
import { getPublishedPosts } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeCopyButton from '../components/CodeCopyButton.astro';
import BackToTop from '../components/BackToTop.astro';

// 关于页内容在 src/content/pages/about.md，用 Markdown 编写。
// 好处是改文字不用碰代码，且不会混进文章列表。
const page = await getEntry('pages', 'about');

if (!page) {
  throw new Error(
    '找不到 src/content/pages/about.md。请确认该文件存在，或检查 src/content.config.ts 里 pages 集合的 base 路径。',
  );
}

const [{ Content }, posts] = await Promise.all([render(page), getPublishedPosts()]);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="container">
    <div class="prose">
      <Content />
    </div>
    <CodeCopyButton />

    <p class="about__footnote">
      目前共有 {posts.length} 篇已发布文章 · <a href="/tags/">按标签浏览</a>
    </p>
  </div>

  <BackToTop />
</BaseLayout>

<style>
  .about__footnote {
    margin-top: var(--space-5);
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
