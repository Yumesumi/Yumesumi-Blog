---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在。">
  <div class="container not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">这个页面不在这里</h1>
    <p class="not-found__desc">
      链接可能已经失效，或者地址输错了。
    </p>
    <div class="not-found__actions">
      <a href="/" class="not-found__btn">回到首页</a>
      <a href="/tags/" class="not-found__btn not-found__btn--ghost">浏览标签</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 55vh;
    gap: 0.5rem;
  }

  .not-found__code {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    opacity: 0.35;
    margin: 0;
  }

  .not-found__title {
    font-size: 1.5rem;
    margin: 0;
  }

  .not-found__desc {
    margin: 0;
    color: var(--text-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: var(--space-4);
  }

  .not-found__btn {
    display: inline-block;
    padding: 0.6rem 1.3rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    color: var(--bg-base);
    background: var(--accent);
    border: 1px solid var(--accent);
    transition: opacity var(--transition), background-color var(--transition);
  }

  .not-found__btn:hover {
    color: var(--bg-base);
    opacity: 0.88;
  }

  .not-found__btn--ghost {
    color: var(--accent);
    background: transparent;
  }

  .not-found__btn--ghost:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
</style>
