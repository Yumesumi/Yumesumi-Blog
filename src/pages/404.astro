---
import { CENTER_NAME, CENTER_URL } from '@/lib/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在。" noindex>
  <div class="not-found ys-container">
    <p class="ys-eyebrow">404 · LOST IN SPACE</p>
    <p class="not-found__code" aria-hidden="true">
      404
    </p>
    <h1 class="not-found__title">这个页面不在这里</h1>
    <p class="not-found__desc">链接可能已经失效，或者地址输错了。</p>

    <div class="not-found__actions">
      <a class="ys-button ys-button--primary" href="/">
        回到首页
      </a>
      <a class="ys-button" href="/tags/">
        浏览标签
      </a>
      <a class="ys-button" href={CENTER_URL} target="_blank" rel="noopener noreferrer">
        前往{CENTER_NAME}
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--ys-space-sm);
    min-block-size: calc(100svh - var(--ys-nav-height) - 16rem);
    padding-block: var(--ys-space-3xl);
    text-align: center;
  }

  .not-found__code {
    font-size: clamp(4rem, 12vw, 9rem);
    font-weight: var(--ys-weight-thin);
    line-height: 1;
    letter-spacing: var(--ys-ls-tight);
    color: transparent;
    background-image: linear-gradient(
      180deg,
      var(--ys-lavender-soft) 0%,
      color-mix(in srgb, var(--ys-purple) 60%, transparent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0.55;
  }

  .not-found__title {
    font-size: var(--ys-fs-xl);
    font-weight: var(--ys-weight-light);
  }

  .not-found__desc {
    color: var(--ys-text-muted);
    font-size: var(--ys-fs-sm);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ys-space-sm);
    margin-block-start: var(--ys-space-md);
  }
</style>
