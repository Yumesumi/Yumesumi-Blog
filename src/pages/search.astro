---
/**
 * 搜索页。
 *
 * 顶栏也有一个搜索框（见 HeaderSearch.astro），两者共用
 * `src/lib/search-client.ts` 里的评分与匹配逻辑，不会出现规则不一致。
 * 区别：顶栏回车跳第一篇，本页列出全部结果。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="搜索梦澄博客的全部文章。">
  <div class="container search-page">
    <header class="search-page__header">
      <h1 class="search-page__title">搜索</h1>
      <p class="search-page__subtitle">输入关键词，按标题、摘要、标签或正文匹配。</p>
    </header>

    <form class="search" role="search" data-search-form autocomplete="off">
      <label class="visually-hidden" for="search-input">搜索文章</label>
      <div class="search__field">
        <svg
          class="search__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input
          id="search-input"
          class="search__input"
          type="search"
          name="q"
          placeholder="搜索文章…"
          data-search-input
          enterkeyhint="search"
        />
        <div class="search__actions">
          <button
            class="search__clear"
            type="button"
            data-search-clear
            hidden
            aria-label="清空搜索"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
          <button class="search__submit" type="submit" aria-label="开始搜索">
            <span class="search__submit-text">搜索</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </button>
        </div>
      </div>
    </form>

    <p class="search__status" data-search-status role="status" aria-live="polite"></p>
    <div class="search__results" data-search-results></div>

    <noscript>
      <p class="search-page__noscript">
        搜索功能需要 JavaScript。你也可以直接<a href="/tags/">按标签浏览</a>。
      </p>
    </noscript>
  </div>
</BaseLayout>

<noscript>
  <style>
    .search { display: none; }
  </style>
</noscript>

<script>
  import {
    loadIndex,
    runSearch,
    highlight,
    excerptAround,
    formatIndexDate,
    toSiteUrl,
    type SearchEntry,
  } from '../lib/search-client';

  const formEl = document.querySelector<HTMLFormElement>('[data-search-form]');
  const inputEl = document.querySelector<HTMLInputElement>('[data-search-input]');
  const clearBtnEl = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const statusEl = document.querySelector<HTMLElement>('[data-search-status]');
  const resultsEl = document.querySelector<HTMLElement>('[data-search-results]');

  if (!formEl || !inputEl || !clearBtnEl || !statusEl || !resultsEl) {
    throw new Error('search.astro: 缺少必需的元素');
  }

  // 赋给新 const，让类型收窄能带进闭包
  const form = formEl;
  const input = inputEl;
  const clearBtn = clearBtnEl;
  const status = statusEl;
  const results = resultsEl;

  let entries: SearchEntry[] = [];

  function render(matched: SearchEntry[], terms: string[]) {
    if (matched.length === 0) {
      const p = document.createElement('p');
      p.className = 'search__none';
      p.textContent = entries.length > 0 ? '没有匹配的文章。' : '';
      results.replaceChildren(p);
      return;
    }

    const nodes = matched.map((entry) => {
      const item = document.createElement('article');
      item.className = 'search-result';

      const date = document.createElement('div');
      date.className = 'search-result__meta';
      const time = document.createElement('time');
      time.dateTime = entry.date;
      time.textContent = formatIndexDate(entry.date);
      date.appendChild(time);

      const heading = document.createElement('h2');
      heading.className = 'search-result__title';
      const link = document.createElement('a');
      link.href = toSiteUrl(entry.url);
      // 内容来自构建期生成的索引，但仍走 highlight（内部先转义）
      link.innerHTML = highlight(entry.title, terms);
      heading.appendChild(link);

      const desc = document.createElement('p');
      desc.className = 'search-result__desc';
      const text = entry.description || excerptAround(entry.body, terms);
      desc.innerHTML = highlight(text, terms);

      item.append(date, heading, desc);

      if (entry.tags.length > 0) {
        const tags = document.createElement('div');
        tags.className = 'search-result__tags';
        for (const [i, tag] of entry.tags.entries()) {
          const a = document.createElement('a');
          a.className = 'search-result__tag';
          a.href = toSiteUrl(entry.tagUrls[i]);
          a.textContent = tag;
          tags.appendChild(a);
        }
        item.appendChild(tags);
      }

      return item;
    });

    results.replaceChildren(...nodes);
  }

  function search(raw: string) {
    const query = raw.trim();
    clearBtn.hidden = query.length === 0;

    if (!query) {
      status.textContent = entries.length > 0 ? `共 ${entries.length} 篇文章可搜索` : '';
      results.replaceChildren();
      return;
    }
    if (entries.length === 0) return;

    const { matched, terms } = runSearch(entries, query);
    status.textContent = `找到 ${matched.length} 篇相关文章`;
    render(matched, terms);
  }

  let timer: number | undefined;
  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => search(input.value), 120);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    search(input.value);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    search('');
    input.focus();
  });

  status.textContent = '正在加载…';
  loadIndex()
    .then((data) => {
      entries = data;
      status.textContent = `共 ${entries.length} 篇文章可搜索`;
      const initial = new URLSearchParams(location.search).get('q');
      if (initial) {
        input.value = initial;
        search(initial);
      }
    })
    .catch(() => {
      status.textContent = '搜索索引加载失败，请稍后重试';
    });
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-page {
    max-width: var(--max-width);
  }

  .search-page__header {
    margin-bottom: var(--space-5);
  }

  .search-page__title {
    font-size: 1.75rem;
    margin: 0 0 0.35rem;
  }

  .search-page__subtitle {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .search-page__noscript {
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .search {
    margin-bottom: var(--space-3);
  }

  .search__field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search__icon {
    position: absolute;
    left: 0.9rem;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    /* 右侧留出操作按钮区域 */
    padding: 0.75rem 7rem 0.75rem 2.5rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }

  .search__input::placeholder {
    color: var(--text-muted);
  }

  .search__input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .search__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }

  .search__clear:hover {
    color: var(--accent);
  }

  .search__clear[hidden] {
    display: none;
  }

  .search__clear svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  /* 清空与提交并排放在输入框右侧 */
  .search__actions {
    position: absolute;
    right: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .search__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.7rem;
    font-size: 0.875rem;
    font-family: inherit;
    color: var(--bg-base);
    background: var(--accent);
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    transition: filter var(--transition);
  }

  .search__submit:hover {
    filter: brightness(1.08);
  }

  .search__submit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .search__submit svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  /* 窄屏只留图标，隐藏「搜索」文字 */
  @media (max-width: 30rem) {
    .search__submit-text {
      display: none;
    }

    .search__submit {
      padding: 0.4rem 0.5rem;
    }

    .search__input {
      padding-right: 5.5rem;
    }
  }

  .search__status {
    margin: 0 0 var(--space-4);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .search__results {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .search__none {
    padding: var(--space-6);
    text-align: center;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
</style>

<style is:global>
  /* 结果项由 JS 动态创建，scoped 样式加不上，必须放全局 */
  .search-result {
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }

  .search-result:hover {
    border-color: var(--border-strong);
  }

  .search-result__meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .search-result__title {
    margin: 0.3rem 0 0.4rem;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .search-result__title a {
    color: var(--text-strong);
  }

  .search-result__title a:hover {
    color: var(--accent);
  }

  .search-result__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .search-result__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.6rem;
  }

  .search-result__tag {
    font-size: 0.6875rem;
    padding: 0.15em 0.55em;
    border-radius: 999px;
    color: var(--text-muted);
    background: var(--surface-raised);
    border: 1px solid var(--border);
  }

  .search-result__tag:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .search-result mark {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: inherit;
    border-radius: 3px;
    padding: 0 0.1em;
  }
</style>
