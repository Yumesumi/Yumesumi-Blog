---
/**
 * 搜索页。
 *
 * 顶栏与这里共用 `lib/search-client.ts` 的评分与匹配逻辑。
 * 顶栏提交后跳到这里，列出全部结果。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
---

<BaseLayout title="搜索" description="搜索梦澄博客的全部文章。">
  <div class="search-page ys-page ys-container">
    <PageHeader
      eyebrow="SEARCH"
      title="搜索"
      description="输入关键词，按标题、摘要、标签或正文匹配。"
    />

    <form class="search" role="search" data-search-form autocomplete="off">
      <label class="ys-sr-only" for="search-input">
        搜索文章
      </label>

      <div class="search__field">
        <svg
          class="search__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>

        <input
          id="search-input"
          class="search__input"
          type="search"
          name="q"
          placeholder="搜索文章…"
          data-search-input
          enterkeyhint="search"
        />

        <div class="search__actions">
          <button
            class="search__clear"
            type="button"
            data-search-clear
            hidden
            aria-label="清空搜索"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>

          <button class="search__submit" type="submit">
            <span class="search__submit-text">搜索</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </button>
        </div>
      </div>
    </form>

    <p class="search__status" data-search-status role="status" aria-live="polite"></p>
    <div class="search__results" data-search-results></div>

    <noscript>
      <p class="search__noscript">
        搜索功能需要 JavaScript。你也可以直接<a href="/tags/">按标签浏览</a>。
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import {
    loadIndex,
    runSearch,
    highlight,
    excerptAround,
    formatIndexDate,
    type SearchEntry,
  } from '@/lib/search-client';

  const formEl = document.querySelector<HTMLFormElement>('[data-search-form]');
  const inputEl = document.querySelector<HTMLInputElement>('[data-search-input]');
  const clearBtnEl = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const statusEl = document.querySelector<HTMLElement>('[data-search-status]');
  const resultsEl = document.querySelector<HTMLElement>('[data-search-results]');

  if (!formEl || !inputEl || !clearBtnEl || !statusEl || !resultsEl) {
    throw new Error('search.astro: 缺少必需的元素');
  }

  const form = formEl;
  const input = inputEl;
  const clearBtn = clearBtnEl;
  const status = statusEl;
  const results = resultsEl;

  let entries: SearchEntry[] = [];

  function render(matched: SearchEntry[], terms: string[]) {
    if (matched.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'search__none';
      empty.textContent = entries.length > 0 ? '没有匹配的文章。' : '';
      results.replaceChildren(empty);
      return;
    }

    const nodes = matched.map((entry) => {
      const item = document.createElement('article');
      item.className = 'search-result ys-card';

      const meta = document.createElement('div');
      meta.className = 'search-result__meta';
      const time = document.createElement('time');
      time.dateTime = entry.date;
      time.textContent = formatIndexDate(entry.date);
      meta.appendChild(time);

      const heading = document.createElement('h2');
      heading.className = 'search-result__title';
      const link = document.createElement('a');
      link.href = entry.url;
      // 内容来自构建期索引，highlight 内部会先转义再插入 <mark>
      link.innerHTML = highlight(entry.title, terms);
      heading.appendChild(link);

      const desc = document.createElement('p');
      desc.className = 'search-result__desc';
      desc.innerHTML = highlight(entry.description || excerptAround(entry.body, terms), terms);

      item.append(meta, heading, desc);

      if (entry.tags.length > 0) {
        const tags = document.createElement('div');
        tags.className = 'search-result__tags';

        for (const [index, tag] of entry.tags.entries()) {
          const anchor = document.createElement('a');
          anchor.className = 'search-result__tag';
          anchor.href = entry.tagUrls[index] ?? '/tags/';
          anchor.textContent = tag;
          tags.appendChild(anchor);
        }

        item.appendChild(tags);
      }

      return item;
    });

    results.replaceChildren(...nodes);
  }

  function search(raw: string) {
    const query = raw.trim();
    clearBtn.hidden = query.length === 0;

    if (!query) {
      status.textContent = entries.length > 0 ? `共 ${entries.length} 篇文章可搜索` : '';
      results.replaceChildren();
      return;
    }

    if (entries.length === 0) return;

    const { matched, terms } = runSearch(entries, query);
    status.textContent = `找到 ${matched.length} 篇相关文章`;
    render(matched, terms);
  }

  let timer: number | undefined;
  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => search(input.value), 120);
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    search(input.value);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    search('');
    input.focus();
  });

  status.textContent = '正在加载…';
  loadIndex()
    .then((data) => {
      entries = data;
      status.textContent = `共 ${entries.length} 篇文章可搜索`;

      const initial = new URLSearchParams(location.search).get('q');
      if (initial) {
        input.value = initial;
        search(initial);
      }
    })
    .catch(() => {
      status.textContent = '搜索索引加载失败，请稍后重试';
    });
</script>

<style>
  .search-page {
    max-inline-size: var(--ys-reading-width);
  }

  .search {
    margin-block-end: var(--ys-space-md);
  }

  .search__field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search__icon {
    position: absolute;
    left: 1rem;
    inline-size: 1.05rem;
    block-size: 1.05rem;
    color: var(--ys-text-muted);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    padding: 0.9rem 8rem 0.9rem 2.85rem;
    font-size: var(--ys-fs-md);
    color: var(--ys-text);
    background-color: var(--ys-prose-bg);
    border: 1px solid var(--ys-border);
    border-radius: var(--ys-radius-lg);
    appearance: none;
    transition:
      border-color var(--ys-dur-fast) var(--ys-ease-out),
      box-shadow var(--ys-dur-fast) var(--ys-ease-out);
  }

  .search__input::-webkit-search-cancel-button {
    display: none;
  }

  .search__input::placeholder {
    color: var(--ys-text-faint);
  }

  .search__input:focus {
    outline: none;
    border-color: var(--ys-border-strong);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ys-purple) 16%, transparent);
  }

  .search__actions {
    position: absolute;
    right: 0.55rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .search__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    color: var(--ys-text-muted);
    background-color: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .search__clear:hover {
    color: var(--ys-lavender);
  }

  .search__clear[hidden] {
    display: none;
  }

  .search__clear svg {
    inline-size: 0.9rem;
    block-size: 0.9rem;
  }

  .search__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.48rem 0.9rem;
    font-size: var(--ys-fs-xs);
    letter-spacing: var(--ys-ls-wide);
    color: var(--ys-text-inverse);
    background-color: var(--ys-lavender);
    border: 0;
    border-radius: var(--ys-radius-pill);
    cursor: pointer;
    transition: background-color var(--ys-dur-fast) var(--ys-ease-out);
  }

  .search__submit:hover {
    background-color: var(--ys-lavender-soft);
  }

  .search__submit svg {
    inline-size: 0.9rem;
    block-size: 0.9rem;
  }

  .search__status {
    margin-block-end: var(--ys-space-md);
    font-size: var(--ys-fs-xs);
    color: var(--ys-text-muted);
  }

  .search__results {
    display: grid;
    gap: var(--ys-space-sm);
  }

  .search__none,
  .search__noscript {
    padding: var(--ys-space-xl);
    text-align: center;
    color: var(--ys-text-muted);
    border: 1px dashed var(--ys-border);
    border-radius: var(--ys-radius-lg);
  }

  .search__noscript a {
    color: var(--ys-lavender);
    text-decoration: underline;
  }

  @media (max-width: 30rem) {
    .search__submit-text {
      display: none;
    }

    .search__submit {
      padding: 0.5rem;
    }

    .search__input {
      padding-right: 5.5rem;
    }
  }
</style>

<style is:global>
  /* 结果项由 JS 动态创建，scoped 样式加不上，必须放全局 */
  .search-result {
    padding: var(--ys-space-md) var(--ys-space-lg);
  }

  .search-result__meta {
    font-size: var(--ys-fs-2xs);
    font-variant-numeric: tabular-nums;
    color: var(--ys-text-faint);
  }

  .search-result__title {
    margin-block: 0.35rem 0.45rem;
    font-size: var(--ys-fs-lg);
    font-weight: var(--ys-weight-medium);
    line-height: var(--ys-lh-snug);
  }

  .search-result__title a {
    color: var(--ys-text-secondary);
    transition: color var(--ys-dur-fast) var(--ys-ease-out);
  }

  .search-result__title a:hover,
  .search-result__title a:focus-visible {
    color: var(--ys-lavender);
  }

  .search-result__desc {
    font-size: var(--ys-fs-sm);
    line-height: var(--ys-lh-relaxed);
    color: var(--ys-text-muted);
  }

  .search-result__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block-start: var(--ys-space-sm);
  }

  .search-result__tag {
    padding: 0.12em 0.6em;
    font-size: var(--ys-fs-3xs);
    color: var(--ys-text-muted);
    background-color: color-mix(in srgb, var(--ys-surface) 52%, transparent);
    border: 1px solid var(--ys-border);
    border-radius: var(--ys-radius-pill);
    transition:
      color var(--ys-dur-fast) var(--ys-ease-out),
      border-color var(--ys-dur-fast) var(--ys-ease-out);
  }

  .search-result__tag:hover,
  .search-result__tag:focus-visible {
    color: var(--ys-lavender);
    border-color: var(--ys-border-strong);
  }

  .search-result mark {
    padding: 0 0.1em;
    color: var(--ys-lavender-soft);
    background-color: color-mix(in srgb, var(--ys-purple) 30%, transparent);
    border-radius: var(--ys-radius-xs);
  }
</style>
