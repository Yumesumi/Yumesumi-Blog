---
import { getPublishedPosts, countTags, tagPath } from '@/lib/posts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';

const posts = await getPublishedPosts();
const tags = countTags(posts);
---

<BaseLayout title="标签" description="按标签浏览梦澄博客的全部文章。">
  <div class="ys-page ys-container ys-container--wide">
    <PageHeader
      eyebrow="INDEX"
      title="标签索引"
      description={`共 ${tags.size} 个标签 · ${posts.length} 篇文章。按主题进入不同的阅读方向。`}
    />

    {tags.size > 0 ? (
      <div class="tag-grid">
        {[...tags].map(([tag, count], index) => (
          <a class="tag-card ys-card" href={tagPath(tag)}>
            <span class="tag-card__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="tag-card__name">{tag}</span>
            <span class="tag-card__count">{count} 篇文章</span>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path
                d="M5 12h14M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ))}
      </div>
    ) : (
      <p class="tags-empty">还没有任何标签。</p>
    )}
  </div>
</BaseLayout>

<style>
  .tag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--ys-space-sm);
  }

  .tag-card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--ys-space-2xs) var(--ys-space-sm);
    padding: var(--ys-space-lg);
  }

  .tag-card:hover {
    transform: translateY(-2px);
  }

  .tag-card__index {
    grid-column: 1;
    font-size: var(--ys-fs-3xs);
    letter-spacing: var(--ys-ls-wide);
    color: var(--ys-text-faint);
  }

  .tag-card__name {
    grid-column: 1;
    font-size: var(--ys-fs-xl);
    font-weight: var(--ys-weight-light);
    color: var(--ys-text-secondary);
    transition: color var(--ys-dur-fast) var(--ys-ease-out);
  }

  .tag-card__count {
    grid-column: 1;
    font-size: var(--ys-fs-2xs);
    color: var(--ys-text-faint);
  }

  .tag-card > svg {
    grid-column: 2;
    grid-row: 1 / span 3;
    color: var(--ys-text-faint);
    transition:
      color var(--ys-dur-fast) var(--ys-ease-out),
      transform var(--ys-dur-fast) var(--ys-ease-out);
  }

  .tag-card:hover .tag-card__name,
  .tag-card:focus-visible .tag-card__name {
    color: var(--ys-text);
  }

  .tag-card:hover > svg {
    color: var(--ys-lavender);
    transform: translateX(3px);
  }

  .tags-empty {
    padding: var(--ys-space-2xl);
    text-align: center;
    color: var(--ys-text-muted);
    border: 1px dashed var(--ys-border);
    border-radius: var(--ys-radius-lg);
  }
</style>
