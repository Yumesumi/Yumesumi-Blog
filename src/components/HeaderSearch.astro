---
/**
 * 顶栏搜索框。
 *
 * 宽屏是一个窄输入框，窄屏（≤ 46rem）收成一个图标按钮。
 * 两种形态共用同一个 input —— 靠 CSS 切换宽度与占位符，
 * 不需要 JS 参与布局判断。
 */
---

<form class="hsearch" role="search" data-hsearch-form autocomplete="off">
  <label class="visually-hidden" for="hsearch-input">搜索文章</label>

  <svg
    class="hsearch__icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="M20 20l-3.5-3.5"></path>
  </svg>

  <input
    id="hsearch-input"
    class="hsearch__input"
    type="search"
    name="q"
    placeholder="搜索…"
    aria-label="搜索文章"
    data-hsearch-input
    enterkeyhint="search"
  />
</form>

<script>
  import { loadIndex, runSearch, toSiteUrl, type SearchEntry } from '../lib/search-client';

  const form = document.querySelector<HTMLFormElement>('[data-hsearch-form]');
  const input = document.querySelector<HTMLInputElement>('[data-hsearch-input]');

  if (form && input) {
    let items: SearchEntry[] = [];

    // 索引预热：空闲时加载，用户敲第一下就不用等。
    // 失败时保持 items 为空，回车会退化为「带关键词去搜索页」，
    // 由那个页面展示加载失败的原因。
    loadIndex()
      .then((data) => {
        items = data;
      })
      .catch(() => {
        /* 已在下面的降级路径里处理 */
      });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const query = input.value.trim();
      if (!query) return;

      // 已有结果就跳第一篇，否则带关键词去搜索页看全部
      if (items.length > 0) {
        const { matched } = runSearch(items, query);
        if (matched.length > 0) {
          location.href = toSiteUrl(matched[0].url);
          return;
        }
      }

      const target = new URL(toSiteUrl('/search/'), location.href);
      target.searchParams.set('q', query);
      location.href = target.href;
    });

    // 桌面端按 / 聚焦；已经在输入态则不拦截
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      const active = document.activeElement;
      if (active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement) return;
      // 窄屏下输入框被 CSS 隐藏，此时 / 应去搜索页而不是聚焦隐藏元素
      if (input.offsetParent === null) return;
      e.preventDefault();
      input.focus();
      input.select();
    });
  }
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hsearch {
    position: relative;
    display: flex;
    align-items: center;
  }

  .hsearch__icon {
    position: absolute;
    left: 0.6rem;
    width: 0.9rem;
    height: 0.9rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .hsearch__input {
    width: 10rem;
    padding: 0.4rem 0.6rem 0.4rem 2rem;
    font-size: 0.8125rem;
    font-family: inherit;
    line-height: 1.4;
    color: var(--text);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: width var(--transition), border-color var(--transition),
      background-color var(--transition);

    /* 隐藏 WebKit 自带的清除按钮，我们用回车跳转 */
    -webkit-appearance: none;
    appearance: none;
  }

  .hsearch__input::-webkit-search-cancel-button {
    display: none;
  }

  .hsearch__input::placeholder {
    color: var(--text-muted);
  }

  .hsearch__input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--surface);
    /* 聚焦时展开，方便看清输入内容 */
    width: 15rem;
  }

  /* 窄屏：收成图标 */
  @media (max-width: 46rem) {
    .hsearch__input {
      width: 2.1rem;
      padding-right: 0.4rem;
      cursor: pointer;
    }

    .hsearch__input::placeholder {
      color: transparent;
    }

    .hsearch__input:focus {
      width: 10rem;
      cursor: text;
    }

    .hsearch__input:focus::placeholder {
      color: var(--text-muted);
    }
  }
</style>
