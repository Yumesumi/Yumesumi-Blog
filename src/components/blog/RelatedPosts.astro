---
import type { Post } from '@/lib/posts';
import { formatDateShort, toISO } from '@/lib/format';

export interface Props {
  currentTags: string[];
  posts: Post[];
  limit?: number;
}

const { currentTags, posts, limit = 3 } = Astro.props satisfies Props;

/**
 * 相关度 = 共同标签数 / 当前文章标签数。
 * 得分相同则按日期倒序（新的优先）。
 */
const scored = posts
  .map((post) => {
    const shared = post.data.tags.filter((tag) => currentTags.includes(tag));
    return { post, score: shared.length / Math.max(1, currentTags.length), shared };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.date.getTime() - a.post.data.date.getTime())
  .slice(0, limit);
---

{scored.length > 0 && (
  <section class="related" aria-labelledby="related-title">
    <div class="related__head">
      <p class="ys-eyebrow">RELATED</p>
      <h2 id="related-title" class="related__title">
        相关阅读
      </h2>
    </div>

    <ul class="related__list">
      {scored.map(({ post, shared }) => (
        <li class="related__item ys-card">
          <a href={`/blog/${post.id}/`} class="related__link">
            <span class="related__meta">
              <time datetime={toISO(post.data.date)}>{formatDateShort(post.data.date)}</time>
              {shared.map((tag) => (
                <span class="related__tag">{tag}</span>
              ))}
            </span>
            <span class="related__name">{post.data.title}</span>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <path
                d="M5 12h14M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related {
    margin-block-start: var(--ys-space-2xl);
    padding-block-start: var(--ys-space-xl);
    border-block-start: 1px solid var(--ys-border-subtle);
  }

  .related__head {
    display: grid;
    gap: var(--ys-space-2xs);
    margin-block-end: var(--ys-space-md);
  }

  .related__title {
    font-size: var(--ys-fs-xl);
    font-weight: var(--ys-weight-light);
    letter-spacing: var(--ys-ls-snug);
  }

  .related__list {
    display: grid;
    gap: var(--ys-space-sm);
  }

  .related__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ys-space-2xs) var(--ys-space-sm);
    padding: var(--ys-space-md);
  }

  .related__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ys-space-2xs);
    font-size: var(--ys-fs-2xs);
    font-variant-numeric: tabular-nums;
    color: var(--ys-text-muted);
  }

  .related__tag {
    padding: 0.05em 0.5em;
    font-size: 0.95em;
    color: var(--ys-text-faint);
    border: 1px solid var(--ys-border-subtle);
    border-radius: var(--ys-radius-pill);
  }

  .related__name {
    grid-column: 1;
    font-size: var(--ys-fs-md);
    color: var(--ys-text-secondary);
    line-height: var(--ys-lh-snug);
    transition: color var(--ys-dur-fast) var(--ys-ease-out);
  }

  .related__link > svg {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--ys-text-faint);
    transition:
      color var(--ys-dur-fast) var(--ys-ease-out),
      transform var(--ys-dur-fast) var(--ys-ease-out);
  }

  .related__link:hover .related__name,
  .related__link:focus-visible .related__name {
    color: var(--ys-text);
  }

  .related__link:hover > svg {
    color: var(--ys-lavender);
    transform: translateX(3px);
  }
</style>
