<form class="search" role="search" data-search-form autocomplete="off">
  <label class="visually-hidden" for="search-input">搜索文章</label>
  <div class="search__field">
    <svg
      class="search__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.5-3.5"></path>
    </svg>
    <input
      id="search-input"
      class="search__input"
      type="search"
      name="q"
      placeholder="搜索文章…"
      data-search-input
      enterkeyhint="search"
    />
    <button class="search__clear" type="button" data-search-clear hidden aria-label="清空搜索">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
</form>

<p class="search__status" data-search-status role="status" aria-live="polite"></p>

<div class="search__results" data-search-results></div>

<template data-search-empty>
  <p class="search__none">没有匹配的文章。</p>
</template>

<script>
  interface SearchEntry {
    url: string;
    title: string;
    description: string;
    tags: string[];
    tagUrls: string[];
    date: string;
    body: string;
  }

  const formEl = document.querySelector<HTMLFormElement>('[data-search-form]');
  const inputEl = document.querySelector<HTMLInputElement>('[data-search-input]');
  const clearBtnEl = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const statusEl = document.querySelector<HTMLElement>('[data-search-status]');
  const resultsEl = document.querySelector<HTMLElement>('[data-search-results]');
  const emptyTplEl = document.querySelector<HTMLTemplateElement>('[data-search-empty]');

  if (!formEl || !inputEl || !clearBtnEl || !statusEl || !resultsEl || !emptyTplEl) {
    throw new Error('SearchBox: 缺少必需的元素，组件结构可能已改动');
  }

  // 赋给新的 const 变量，让 TypeScript 把非空类型带进闭包。
  // （直接用 querySelector 的结果，即使加了守卫，
  //   在嵌套函数中仍会被视为可能为 null。）
  const form = formEl;
  const input = inputEl;
  const clearBtn = clearBtnEl;
  const status = statusEl;
  const results = resultsEl;
  const emptyTpl = emptyTplEl;

  {
    let entries: SearchEntry[] = [];
    let loadingFailed = false;

    /** 把匹配片段里的关键词高亮（先转义，避免 XSS） */
    function highlight(text: string, query: string): string {
      const escaped = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      if (!query) return escaped;
      const pattern = query
        .split(/\s+/)
        .filter(Boolean)
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
        .join('|');
      return escaped.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
    }

    /** 取包含关键词的正文片段 */
    function excerptAround(body: string, query: string): string {
      if (!query) return body.slice(0, 120);
      const idx = body.toLowerCase().indexOf(query.toLowerCase().split(/\s+/)[0] ?? '');
      if (idx === -1) return body.slice(0, 120);
      const start = Math.max(0, idx - 40);
      return (start > 0 ? '…' : '') + body.slice(start, start + 140);
    }

    function score(entry: SearchEntry, terms: string[]): number {
      const title = entry.title.toLowerCase();
      const desc = entry.description.toLowerCase();
      const tags = entry.tags.join(' ').toLowerCase();
      const body = entry.body.toLowerCase();

      let total = 0;
      for (const t of terms) {
        // 标题命中权重最高，标签次之，正文最低
        if (title.includes(t)) total += 10;
        if (tags.includes(t)) total += 5;
        if (desc.includes(t)) total += 3;
        if (body.includes(t)) total += 1;
      }
      return total;
    }

    function render(list: SearchEntry[], query: string) {
      if (list.length === 0) {
        results.replaceChildren(emptyTpl.content.cloneNode(true));
        return;
      }

      const nodes = list.map((entry) => {
        const item = document.createElement('article');
        item.className = 'search-result';

        const date = new Intl.DateTimeFormat('zh-CN', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).format(new Date(entry.date));

        const tagsHtml = entry.tags
          .map(
            (tag, i) =>
              `<a class="search-result__tag" href="${entry.tagUrls[i]}">${tag}</a>`,
          )
          .join('');

        item.innerHTML = `
          <div class="search-result__meta"><time datetime="${entry.date}">${date}</time></div>
          <h2 class="search-result__title"><a href="${entry.url}">${highlight(entry.title, query)}</a></h2>
          <p class="search-result__desc">${highlight(entry.description || excerptAround(entry.body, query), query)}</p>
          ${tagsHtml ? `<div class="search-result__tags">${tagsHtml}</div>` : ''}
        `;
        return item;
      });

      results.replaceChildren(...nodes);
    }

    function search(raw: string) {
      const query = raw.trim();
      clearBtn.hidden = query.length === 0;

      if (!query) {
        status.textContent = entries.length > 0 ? `共 ${entries.length} 篇文章可搜索` : '';
        results.replaceChildren();
        return;
      }
      if (entries.length === 0) {
        status.textContent = loadingFailed ? '搜索索引加载失败' : '正在加载…';
        return;
      }

      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      const matched = entries
        .map((entry) => ({ entry, s: score(entry, terms) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .map((x) => x.entry);

      status.textContent = `找到 ${matched.length} 篇相关文章`;
      render(matched, query);
    }

    // 防抖，避免每敲一个字就重算
    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => search(input.value), 120);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      search(input.value);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      search('');
      input.focus();
    });

    // 支持 / 键聚焦搜索框（不在输入态时）
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      const active = document.activeElement;
      const typing =
        active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement;
      if (typing) return;
      e.preventDefault();
      input.focus();
    });

    /**
     * 定位搜索索引。
     *
     * 不能直接写 '/search-index.json' —— 站点同时支持根路径（域名生效后）
     * 和子路径（github.io 回退地址），绝对路径在子路径下会 404。
     * 从当前页面向上退到站点根再拼文件名，两种情况都对。
     * 页面本身一定在 <站点根>/search/ 下，所以退一层即可。
     */
    function indexUrl(): string {
      return new URL('../search-index.json', location.href).href;
    }

    // 异步加载索引
    status.textContent = '正在加载…';
    fetch(indexUrl())
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json();
      })
      .then((data: SearchEntry[]) => {
        entries = data;
        status.textContent = `共 ${entries.length} 篇文章可搜索`;
        // 支持带 ?q= 访问
        const initial = new URLSearchParams(location.search).get('q');
        if (initial) {
          input.value = initial;
          search(initial);
        }
      })
      .catch(() => {
        loadingFailed = true;
        status.textContent = '搜索索引加载失败，请稍后重试';
      });
  }
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search {
    margin-bottom: var(--space-3);
  }

  .search__field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search__icon {
    position: absolute;
    left: 0.9rem;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }

  .search__input::placeholder {
    color: var(--text-muted);
  }

  .search__input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .search__clear {
    position: absolute;
    right: 0.6rem;
    display: inline-flex;
    padding: 0.3rem;
    color: var(--text-muted);
    border-radius: 6px;
  }

  .search__clear:hover {
    color: var(--accent);
  }

  .search__clear[hidden] {
    display: none;
  }

  .search__clear svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .search__status {
    margin: 0 0 var(--space-4);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .search__results {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .search__none {
    padding: var(--space-6);
    text-align: center;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
</style>

<style is:global>
  /* 结果项的样式放在全局，因为它们由 JS 动态创建，
     组件的 scoped 样式加不上 */
  .search-result {
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }

  .search-result:hover {
    border-color: var(--border-strong);
  }

  .search-result__meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .search-result__title {
    margin: 0.3rem 0 0.4rem;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .search-result__title a {
    color: var(--text-strong);
  }

  .search-result__title a:hover {
    color: var(--accent);
  }

  .search-result__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .search-result__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.6rem;
  }

  .search-result__tag {
    font-size: 0.6875rem;
    padding: 0.15em 0.55em;
    border-radius: 999px;
    color: var(--text-muted);
    background: var(--surface-raised);
    border: 1px solid var(--border);
  }

  .search-result__tag:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .search-result mark {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: inherit;
    border-radius: 3px;
    padding: 0 0.1em;
  }
</style>
