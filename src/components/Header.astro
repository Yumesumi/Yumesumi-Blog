---
import ThemeToggle from './ThemeToggle.astro';
import HeaderSearch from './HeaderSearch.astro';

const nav = [
  { href: '/', label: '首页' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];

const pathname = Astro.url.pathname.replace(/\/index\.html$/, '/');
const current = pathname === '/' ? '/' : `${pathname.replace(/\/$/, '')}/`;
---

<header class="site-header">
  <div class="container site-header__inner">
    <!--
      标记站点根地址。搜索结果里的链接是 /blog/xxx/ 这种绝对路径，
      而站点同时支持根路径与 github.io 子路径两种访问方式，
      JS 需要靠这个标记把绝对路径解析成当前站点下可用的地址。
    -->
    <a href="/" class="site-header__brand" data-site-root>
      <img src="/favicon.svg" alt="" width="28" height="28" class="site-header__mark" />
      <span>梦澄博客</span>
    </a>

    <div class="site-header__right">
      <nav aria-label="主导航">
        <ul class="site-header__nav">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['site-header__link', { 'is-active': current === item.href }]}
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <HeaderSearch />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg-base) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--transition), border-color var(--transition);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--text-strong);
    white-space: nowrap;
    /* 空间不足时优先压缩搜索框，不压缩站名与导航 */
    flex-shrink: 0;
  }

  .site-header__brand:hover {
    color: var(--accent);
  }

  /*
    品牌标记用 favicon.svg，与浏览器标签页图标保持一致。
    用 img 而非 CSS 渐变：图标是设计好的资产，重复实现一份
    渐变+边框只会让两者随时间不一致。
    深浅主题下都能看清 —— 图标本身自带紫粉渐变底。
  */
  .site-header__mark {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 7px;
    flex-shrink: 0;
    display: block;
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    /* 不参与压缩：空间不足时若允许收缩，中文链接会被逐字挤成竖排 */
    flex-shrink: 0;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__link {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    font-size: 0.9375rem;
    color: var(--text-muted);
    /* 中文没有词间空格，不加这行窄屏下会逐字竖排 */
    white-space: nowrap;
    transition: color var(--transition), background-color var(--transition);
  }

  .site-header__link:hover {
    color: var(--accent);
    background: var(--surface-raised);
  }

  .site-header__link.is-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  /* 窄屏：站名、导航、搜索框、主题按钮要挤进一行，
     通过收紧内边距与间距来腾空间，避免出现横向滚动 */
  @media (max-width: 34rem) {
    .site-header .container {
      padding-inline: var(--space-3);
    }

    .site-header__inner {
      gap: var(--space-2);
    }

    .site-header__right {
      gap: var(--space-2);
    }

    .site-header__nav {
      gap: 0;
    }

    .site-header__link {
      padding: 0.4rem 0.4rem;
      font-size: 0.875rem;
    }

    .site-header__brand {
      gap: 0.4rem;
      font-size: 1rem;
    }
  }
</style>
